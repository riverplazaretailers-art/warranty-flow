# Warranty Flow — example configuration. No secrets belong in this file or in browser code.

# Parent TwoRiverOps site, used by the "Back to TwoRiverOps" navigation.
VITE_TWORIVEROPS_URL=https://tworiverops.com

# Preserved secure workspace. When set (and no compatible API contract is configured),
# real-work CTAs are handed off to this URL instead of running locally.
VITE_SECURE_WORKSPACE_URL=

# Portable Warranty Flow service base URL. Leave empty to run the synthetic demo.
# A base URL alone does NOT enable live mode; a compatible contract version is also required.
VITE_API_BASE_URL=

# Contract version the frontend supports. Partial configuration fails closed to demo mode.
VITE_API_CONTRACT_VERSION=2026-08-01
